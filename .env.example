# 環境変数の見本（値は入れない）。Spaces では Settings > Secrets / Variables に登録する
# 全て未設定でも、トップページと3件のデモは動く

# --- Secrets（秘密情報）---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 利用記録の保存先。どちらも未設定なら有料処理は停止する
# 第一候補：Hugging Face の非公開データセット（書き込み権限のトークンが必要）
HF_TOKEN=
USAGE_HF_DATASET=
# 代替：外部の PostgreSQL（Spaces の通信制限により接続できない場合がある）
USAGE_DATABASE_URL=
# AIパスワード（カンマ区切り）。未設定なら有料処理は誰も使えない
DEFINEREQ_ACCESS_CODES=

# --- Variables（秘密でない設定）---
# 月額のAPI予算（円）。月額上限1万円から固定費と余裕を除いた額
DEFINEREQ_MONTHLY_API_BUDGET_JPY=7000
DEFINEREQ_CODE_BUDGET_JPY=2500
DEFINEREQ_CODE_RUNS=80
DEFINEREQ_CODE_MINUTES=240
DEFINEREQ_USD_JPY=160
DEFINEREQ_AI_MODEL=claude-opus-5-5
DEFINEREQ_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize

# --- 手元の開発のみ ---
# DEFINEREQ_ALLOW_LOCAL_LEDGER=1
